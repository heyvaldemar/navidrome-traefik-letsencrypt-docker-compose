# Navidrome + Traefik + Let's Encrypt — Environment Variables
# Copy this file to `.env` and fill in each value before `docker compose up`.
# `.env` is gitignored — never commit real credential values.
#
# Image versions are NOT set here. The tested tag + sha256 digest for every
# image lives in the compose file's `x-images` block, so `git pull` delivers
# the version combination this repository has tested. To pin a different
# version yourself, uncomment and set:
# NAVIDROME_IMAGE_TAG=deluan/navidrome:0.64.0@sha256:…

# ──────────────────────────────────────────────────────────────────────────────
# Traefik reverse proxy
# ──────────────────────────────────────────────────────────────────────────────

# Email address for Let's Encrypt renewal notices. REQUIRED.
TRAEFIK_ACME_EMAIL=admin@example.com

# Hostname for the Traefik dashboard (basic-auth protected). REQUIRED.
TRAEFIK_HOSTNAME=traefik.navidrome.example.com

# Basic Authentication for the Traefik dashboard.
# Format: USERNAME:BCRYPT_HASH (with $ characters doubled to $$ for compose)
#     htpasswd -nbB traefikadmin YOUR_STRONG_PASSWORD | sed 's/\$/\$\$/g'
# REQUIRED — do not ship production without changing this.
TRAEFIK_BASIC_AUTH=change_me_generate_with_htpasswd_and_replace_this_string

# Log level: DEBUG, INFO, WARN, ERROR. Default: WARN.
# TRAEFIK_LOG_LEVEL=WARN

# ──────────────────────────────────────────────────────────────────────────────
# Navidrome
# ──────────────────────────────────────────────────────────────────────────────

# Public hostname. Must resolve to this server's public IP for the
# Let's Encrypt TLS-ALPN challenge. REQUIRED.
NAVIDROME_HOSTNAME=music.example.com

# Where your music actually lives on this host. Mounted READ-ONLY, as
# upstream's own documentation asks: Navidrome never writes here, and a scanner
# with write access to the collection is one bad release away from a very long
# restore. Defaults to ./music so the stack starts before you have decided.
# NAVIDROME_MUSIC_PATH=/mnt/storage/music

# There is no password to set here. The first account created through the web
# interface becomes the administrator, and until that happens the sign-up form
# is open to whoever reaches it.
# **Open the site and create your account immediately after deploy.**

# When to rescan the library. A cron expression, or @every 24h, or an empty
# string to disable scheduled scans entirely. A full scan of a large collection
# is the one thing that makes this container expensive, which is why the
# default is nightly rather than continuous.
# NAVIDROME_SCAN_SCHEDULE=@every 24h

# How long a browser session stays signed in.
# NAVIDROME_SESSION_TIMEOUT=24h

# Set only if you serve Navidrome under a path rather than at the root of its
# own hostname (this template gives it a hostname, so leave it empty).
# NAVIDROME_BASE_URL=

# Let clients that cannot play the source format ask for something else.
# NAVIDROME_ENABLE_TRANSCODING_CONFIG=true

# Album and artist art fetched from external services. Setting this to false
# stops the container making any outbound request at all.
# NAVIDROME_ENABLE_EXTERNAL_SERVICES=true

# Timezone used for timestamps and the scan schedule.
# NAVIDROME_TZ=Etc/UTC

# Log level: error, warn, info, debug, trace. Default: info.
# NAVIDROME_LOG_LEVEL=info

# How long Traefik will hold a single response open. A transcoded stream lasts
# as long as the track, so the default here is 0 — no limit. Raise the idle
# timeout instead if you want abandoned connections reaped sooner.
# NAVIDROME_STREAM_TIMEOUT=0s
# NAVIDROME_IDLE_TIMEOUT=600s

# ──────────────────────────────────────────────────────────────────────────────
# Running as a non-root uid
# ──────────────────────────────────────────────────────────────────────────────
#
# Upstream recommends running as the owner of the music library, and this
# template does not do that by default — because it cannot do it safely for
# everyone. The image's /data is owned by root, so a `user:` override on a
# fresh NAMED VOLUME produces a container that cannot write its own database.
#
# It is the right thing to do when you bind-mount /data on a host directory you
# own. To do that, add an override file of your own:
#
#   services:
#     navidrome:
#       user: "1000:1000"
#       volumes: !override
#         - /srv/navidrome/data:/data
#         - /mnt/storage/music:/music:ro
#
# and `chown -R 1000:1000 /srv/navidrome/data` FIRST. Get the numbers from the
# host with `id -u` and `id -g`; the music only has to be readable by them.
#
# In the meantime the container drops every Linux capability, which is worth
# more than the uid on a service that is one Go binary serving HTTP.

# ──────────────────────────────────────────────────────────────────────────────
# Backups (defaults shown; override only to tune)
# ──────────────────────────────────────────────────────────────────────────────
#
# The archive covers /data: users, playlists, play counts, ratings, starred
# items, client tokens, the search index and the artwork cache. It does NOT
# cover your music — that is mounted read-only and belongs to whatever backs up
# the disk it lives on.

# BACKUP_INIT_SLEEP=30m
# BACKUP_INTERVAL=24h
# DATA_BACKUP_PRUNE_DAYS=7
# DATA_BACKUPS_PATH=/srv/navidrome-data/backups
# DATA_PATH=/data
# DATA_BACKUP_NAME=navidrome-data-backup

# Resource limits (defaults shown). What moves these is the first full scan of
# a large library and on-the-fly transcoding, not steady playback.
# NAVIDROME_MEMORY_LIMIT=1g
# NAVIDROME_CPU_LIMIT=2.0
# NAVIDROME_MEMORY_RESERVATION=128m
# NAVIDROME_CPU_RESERVATION=0.2
# TRAEFIK_MEMORY_LIMIT=256m
# TRAEFIK_CPU_LIMIT=0.5
# TRAEFIK_MEMORY_RESERVATION=64m
# TRAEFIK_CPU_RESERVATION=0.1
# NAVIDROME_BACKUPS_MEMORY_LIMIT=256m
# NAVIDROME_BACKUPS_CPU_LIMIT=0.5
# NAVIDROME_BACKUPS_MEMORY_RESERVATION=16m
# NAVIDROME_BACKUPS_CPU_RESERVATION=0.1

# How long docker waits before SIGKILL. The data directory holds a SQLite
# database that is written on every scrobble and every scan.
# NAVIDROME_STOP_GRACE_PERIOD=60s

# Image versions. Every image is pinned by digest inside the compose file
# (x-images block); set the matching variable here to run a different version
# of that one image while every other pin stays as tested. Needs Docker
# Compose v2.5 or newer (2022).
# TRAEFIK_IMAGE_VERSION=3.7
# NAVIDROME_IMAGE_VERSION=0.64.0
# NAVIDROME_BACKUPS_IMAGE_VERSION=3.22
